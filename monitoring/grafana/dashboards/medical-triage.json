      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (code) (label_replace(rate(http_requests_total[1m]), \"code\", \"${1}xx\", \"status\", \"(.)..\")) ",
